{
  // F5 builds the extension and opens a second VS Code window with it loaded,
  // on the sample problems in extension/test/fixtures/workspace.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DSA Drill extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension",
        "${workspaceFolder}/extension/test/fixtures/workspace"
      ],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js"],
      "preLaunchTask": "Extension: build"
    }
  ]
}
